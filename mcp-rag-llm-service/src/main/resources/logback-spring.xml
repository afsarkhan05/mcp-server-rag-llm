<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- File Appender -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>/tmp/spring-mcp-server.log</file>

        <!-- Rolling policy -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>/tmp/spring-mcp-server-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>

        <!-- Format -->
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Console Appender - DISABLED for stdio! -->
    <!-- DO NOT enable this with stdio transport -->

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="FILE" />
    </root>

    <!-- Your package with DEBUG -->
    <logger name="com.afsarkhan05" level="DEBUG" />

    <!-- Quiet some noisy frameworks -->
    <logger name="org.springframework" level="WARN" />
    <logger name="org.hibernate" level="WARN" />

</configuration>